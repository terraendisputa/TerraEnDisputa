# Desktop app built by the project's CI; scripts/packaging-update.mjs sets the version and checksum.
pkgname=terra-en-disputa-bin
_appid=io.github.terraendisputa.TerraEnDisputa
pkgver=1.1.0
pkgrel=1
pkgdesc='Turn-based strategy game for 2 to 6 players, hosted on your own computer'
arch=('x86_64')
url='https://terraendisputa.github.io/TerraEnDisputa/'
license=('AGPL-3.0-only')
depends=('alsa-lib' 'gtk3' 'libnotify' 'libsecret' 'libxss' 'libxtst' 'nss' 'xdg-utils')
provides=('terra-en-disputa')
conflicts=('terra-en-disputa')
options=('!strip' '!debug')
source=("https://github.com/terraendisputa/TerraEnDisputa/releases/download/v${pkgver}/terra-en-disputa-${pkgver}-linux-x64.tar.gz")
sha256sums=('8d6da6baa2079620a2c48aa5f7a79c33b0d8227c3fb018be56af9fc2cac17c74')

package() {
  cd "terra-en-disputa-${pkgver}-linux-x64"
  install -d "${pkgdir}/opt/terra-en-disputa" "${pkgdir}/usr/bin"
  cp -a . "${pkgdir}/opt/terra-en-disputa/"
  chmod 4755 "${pkgdir}/opt/terra-en-disputa/chrome-sandbox"
  ln -s /opt/terra-en-disputa/terra-en-disputa "${pkgdir}/usr/bin/terra-en-disputa"
  install -Dm644 "resources/linux/${_appid}.desktop" "${pkgdir}/usr/share/applications/${_appid}.desktop"
  install -Dm644 "resources/linux/${_appid}.metainfo.xml" "${pkgdir}/usr/share/metainfo/${_appid}.metainfo.xml"
  install -Dm644 resources/icon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_appid}.png"
  install -Dm644 resources/LICENSE.ted "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
